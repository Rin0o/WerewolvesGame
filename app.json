{
  "expo": {
    "name": "Werewolves of Miller's Hollow",
    "slug": "werewolves-millers-hollow",
    "owner": "Rino0",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/game_icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.willcode4beer.werewolves"
    },
    "android": {
      "package": "com.willcode4beer.werewolves",
      "versionCode": 6,
      "adaptiveIcon": {
        "foregroundImage": "./assets/game_icon.png",
        "backgroundColor": "#0D0820"
      }
    },
    "web": {},
    "plugins": [
      "expo-status-bar",
      "expo-audio",
      "expo-asset",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to use the camera to scan a room's QR code.",
          "recordAudioAndroid": false
        }
      ],
      "./plugins/withReleaseSigning"
    ]
  }
}
